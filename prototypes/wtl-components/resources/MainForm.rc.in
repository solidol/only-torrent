#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "Resource.h"

IDR_MAINFRAME ICON "@OT_ICON@"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/resources/MainForm.manifest"
IDR_MAINFRAME MENU
BEGIN
  POPUP "Файл"
  BEGIN
    MENUITEM "Додати демозадачу\tCtrl+O", ID_TASK_ADD
    MENUITEM SEPARATOR
    MENUITEM "Вихід\tAlt+F4", ID_PROTO_EXIT
  END
  POPUP "Задача"
  BEGIN
    MENUITEM "Пуск", ID_TASK_START
    MENUITEM "Пауза", ID_TASK_PAUSE
    MENUITEM "Перевірити демоблоки", ID_TASK_RECHECK
    MENUITEM SEPARATOR
    MENUITEM "Видалити демозадачу\tDelete", ID_TASK_REMOVE
  END
  POPUP "Вигляд"
  BEGIN
    MENUITEM "Панель відомостей", ID_VIEW_DETAILS, CHECKED
    MENUITEM "Анімація демопрогресу\tF5", ID_DEMO_ANIMATE
  END
  POPUP "Довідка"
  BEGIN
    MENUITEM "Про прототип", ID_PROTO_ABOUT
  END
END
IDR_CONTEXT MENU
BEGIN
  POPUP "Задача"
  BEGIN
    MENUITEM "Пуск", ID_TASK_START
    MENUITEM "Пауза", ID_TASK_PAUSE
    MENUITEM "Перевірити демоблоки", ID_TASK_RECHECK
    MENUITEM SEPARATOR
    MENUITEM "Видалити демозадачу", ID_TASK_REMOVE
  END
END
IDR_MAINFRAME ACCELERATORS
BEGIN
  "O", ID_TASK_ADD, VIRTKEY, CONTROL
  VK_DELETE, ID_TASK_REMOVE, VIRTKEY
  VK_F5, ID_DEMO_ANIMATE, VIRTKEY
END
IDD_DETAILS DIALOGEX 0, 0, 480, 130
STYLE DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
  CONTROL "", IDC_DETAILS_TABS, WC_TABCONTROL, WS_CHILD | WS_VISIBLE | WS_TABSTOP, 0, 0, 480, 130
  EDITTEXT IDC_DETAILS_TEXT, 5, 22, 470, 103, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END
STRINGTABLE
BEGIN
  IDR_MAINFRAME "Only Torrent — WTL компоненти"
END
1 VERSIONINFO
 FILEVERSION 0,0,1,0
 PRODUCTVERSION 0,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "FileDescription", "Only Torrent WTL Components prototype\0"
      VALUE "ProductName", "Only Torrent WTL Components\0"
      VALUE "FileVersion", "0.0.1.0\0"
      VALUE "OriginalFilename", "otorrent-wtl-components.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
